# =============================================================================
# All variables are now runtime — set them here for local dev.
# In Docker, set them as container environment variables (see docker-compose.yml).
# No values are baked into the JS bundle at build time.
# =============================================================================

# ---------------------------------------------------------------------------
# Frontend config (returned by GET /config, read by the browser at startup)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://your-api-server-url
VITE_OAUTH2_CLIENT_ID=rc-client
VITE_OAUTH2_REDIRECT_URI=http://localhost:3000/callback
VITE_ORY_HYDRA_PUBLIC=http://localhost:3000/ory/hydra
VITE_ORY_KRATOS_PUBLIC=http://localhost:3000/ory/kratos
VITE_EXT_OIDC_CLIENT_ID=your-ext-oidc-client-id
VITE_EXT_OIDC_REDIRECT_URI=http://localhost:3000/callback
VITE_ISSUER_DID=
VITE_SCHEMA_ID=
VITE_SCHEMA_VERSION=
VITE_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Secrets — server-side only. Never sent to the browser.
# ---------------------------------------------------------------------------
# Client IDs are already set above as VITE_OAUTH2_CLIENT_ID / VITE_EXT_OIDC_CLIENT_ID.
# The server reads those same vars — no duplication needed.
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
EXT_OIDC_CLIENT_SECRET=your-ext-oidc-client-secret

# Session store (BFF pattern — tokens are kept server-side only).
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# SESSION_DB_URL should point to the same PostgreSQL instance used by Hydra.
SESSION_SECRET=generate-with-node-crypto-randomBytes-64
SESSION_DB_URL=postgresql://user:password@localhost:5432/hydra

# ---------------------------------------------------------------------------
# Proxy targets — internal addresses the Express server forwards requests to.
# In local dev these point to services running on localhost.
# ---------------------------------------------------------------------------
PORT=3000
ORY_HYDRA_ADMIN_URL=http://localhost:4445
ORY_HYDRA_PUBLIC_URL=http://localhost:4444
ORY_KRATOS_PUBLIC_URL=http://localhost:4433
API_BASE_URL=http://localhost:8081
CREDENTIAL_SERVICE_URL=http://localhost:3005
EXT_OIDC_BASE_URL=https://cuenta.digital.gob.do
